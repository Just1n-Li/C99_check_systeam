# FAISS / RAG
FAISS_INDEX_DIR=./data/faiss
# 清洗同学交付目录（chunks.jsonl + laws.json）
LAW_DATA_DIR=./data_cleaned
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5

# 多轮会话：默认本地 SQLite（不连远程服务器）
SESSION_BACKEND=sqlite
SQLITE_SESSION_PATH=./data/sessions.db
ENABLE_MYSQL=off
ENABLE_NEO4J=off

# 仅当 SESSION_BACKEND=mysql 时需要
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DB=legal_qa

# 本地 Ollama（推荐）
USE_OLLAMA=on
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5:7b

# 或云端 OpenAI 兼容 API
# USE_OLLAMA=off
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL_NAME=deepseek-chat

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
SESSION_MAX_TURNS=8
